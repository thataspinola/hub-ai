# Modelo de desenvolvimento local. Copie para .env.local e preencha os valores.
# Nao versionar .env.local, tokens, secrets ou credenciais reais.
# NODE_ENV e definido pelo Next.js; nao o configure neste modelo.

# NextAuth: URL completa da rota de autenticacao, incluindo o basePath do painel.
# Ajuste a porta se executar em outra porta; cadastre os callbacks no provedor.
NEXTAUTH_URL=http://localhost:3000/react-ssr-corp-hubv-painel-administrativo/api/auth
# Gere um valor aleatorio por ambiente; obrigatorio para autenticacao/producao.
NEXTAUTH_SECRET=

# Keycloak: preencher com valores aprovados para o ambiente autorizado.
# ISSUER: https://HOST/realms/REALM (inclua /auth se o provedor utilizar).
# LOGOUT: https://HOST/realms/REALM/protocol/openid-connect/logout
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ISSUER=
NEXTAUTH_LOGOUT=

# URL base da API consumida pelo navegador; nunca coloque secrets em NEXT_PUBLIC_*.
# As telas que dependem dessa API exigem um endpoint configurado e acessivel.
NEXT_PUBLIC_API=

# Em desenvolvimento, true exige login nas rotas administrativas.
# Em producao a autenticacao e sempre exigida, independentemente desta opcao.
HUB_AI_REQUIRE_AUTH=false
# Role administrativa exigida; vazia permite qualquer sessao autenticada valida.
HUB_AI_ADMIN_ROLE=

# Flags: localStorage (padrao local) ou appconfig (agent acessado pelo servidor).
FEATURE_FLAGS_PROVIDER=localStorage
# Preencher os tres IDs abaixo somente ao habilitar appconfig.
APPCONFIG_APPLICATION_ID=
APPCONFIG_ENVIRONMENT_ID=
APPCONFIG_CONFIGURATION_PROFILE_ID=
APPCONFIG_AGENT_ENDPOINT=http://localhost:2772

# Login fictício apenas para desenvolvimento local.
HUB_AI_LOCAL_DEMO_AUTH=false
NEXT_PUBLIC_HUB_AI_LOCAL_DEMO_AUTH=false

# URL base do backend de clientes (somente servidor). Em produção, usar HTTPS.
# Os endpoints esperados são GET/POST /cliente e PUT/DELETE /cliente/{codigo}.
CLIENTES_API_URL=
