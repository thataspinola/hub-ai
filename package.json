{
  "name": "@ignitra-tech/hub-ai",
  "aplicacao": "hub-ai",
  "version": "1.3.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "postbuild": "npm run copy:public && npm run copy:static",
    "copy:public": "copyfiles \"public/**/*\" \"dist/hub-ai/standalone\"",
    "copy:static": "copyfiles -u 2 \"dist/hub-ai/static/**/*\" \"dist/hub-ai/standalone/dist/hub-ai\"",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "next": "15.4.3",
    "next-auth": "^4.24.11",
    "next-runtime-env": "^2.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.17.12",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "copyfiles": "^2.4.1",
    "eslint": "^9",
    "eslint-config-next": "^14.2.35",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.12.2"
  }
}
