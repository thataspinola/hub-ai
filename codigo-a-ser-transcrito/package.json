{
  "name": "hub-ai-resource-toolkit",
  "version": "1.6.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "validate": "node scripts/validate.js",
    "test": "node --test tests/tooling/*.test.js",
    "check": "npm run validate && npm test && npm --prefix examples/node-backend test && npm --prefix ../examples/nest-backend run test:automated",
    "install:profile": "node scripts/install.js",
    "doctor": "node scripts/doctor.js",
    "catalog:export": "node scripts/export-catalog.js",
    "project:inspect": "node scripts/project-context.js"
  },
  "devDependencies": {
    "yaml": "2.8.1"
  }
}
