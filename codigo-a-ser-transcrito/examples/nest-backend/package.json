{
  "name": "hub-ai-nest-backend-example",
  "version": "1.3.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand --selectProjects unit",
    "test:integration": "jest --runInBand --selectProjects integration",
    "test:e2e": "jest --runInBand --selectProjects e2e",
    "test:automated": "npm run typecheck && npm run build && npm run test:build && npm test",
    "test:cov": "jest --runInBand --coverage",
    "test:build": "node scripts/smoke-build.cjs"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.7",
    "@types/jest": "30.0.0",
    "@types/node": "22.18.6",
    "@types/supertest": "6.0.3",
    "jest": "30.5.2",
    "supertest": "7.1.4",
    "ts-jest": "29.4.14",
    "typescript": "5.9.3"
  }
}
